# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env or .env.local to Git!

# AI Provider Configuration
# Options: groq, gemini
AI_PROVIDER=groq

# Groq API Configuration (Primary Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: Override defaults
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MAX_RETRIES=3
# GROQ_TIMEOUT_SECONDS=30

# Gemini AI API Configuration (Alternative Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# Advanced: Override API version or base URL if needed
# GEMINI_API_VERSION=v1beta
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MAX_RETRIES=3
# GEMINI_TIMEOUT_SECONDS=30

# Google Places API (for tourist attraction & restaurant photo fetching)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Database Configuration (Docker / Local Postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aitinerary
DB_USERNAME=aitinerary_user
DB_PASSWORD=change_this_password

# Database Configuration (Production / Cloud Postgres with pgvector like Supabase / Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Application Profile Configuration
# Options: dev (H2 in-memory), docker (local postgres container), prod (cloud postgres)
SPRING_PROFILES_ACTIVE=dev
