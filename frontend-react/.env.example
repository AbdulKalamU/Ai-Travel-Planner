# Frontend Environment Variables Template
# Copy this file to .env or configure in Vercel project settings

# Backend API Base URL (leave empty in local dev to use Vite proxy, or point to your deployed backend)
# Example for local development with proxy: /api/v1
# Example for production on Render: https://ai-tinerary-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api/v1
